# LLM Providers (Groq is the primary fast engine: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Reddit API Credentials (for Phase 2)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=groww_sip_discovery_agent/1.0

# YouTube Data API v3 (for Phase 2)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Application Settings
DATABASE_PATH=data/app.db
LOG_LEVEL=INFO
HASH_SALT=groww_sip_discovery_salt_2026
